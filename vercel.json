{
    "framework": "nextjs",
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next"
        }
    ],
    "rewrites": [
        {
            "source": "/api/chat",
            "destination": "https://862j4mcp.up.railway.app/chat"
        },
        {
            "source": "/api/history/:path*",
