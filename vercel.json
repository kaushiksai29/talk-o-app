{
    "framework": "nextjs",
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next"
        },
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/docs",
            "destination": "/api/docs"
        },
        {
            "source": "/openapi.json",
            "destination": "/api/openapi.json"
        }
    ]
}
